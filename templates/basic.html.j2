<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Dictionary</title>
  <style>
    body { max-width: 45rem; margin: 2rem auto; padding: 0 1rem; }
    article { margin-bottom: 2rem; }
  </style>
</head>
<body>
  <h1>Dictionary</h1>

  {% macro definitions(entry) %}
    <ol>
      {% for definition in entry.definitions %}
        <li>
          {% if definition.typ %}
            <i>{{ definition.typ | html_escape }}</i>
          {% endif %}
          {{ definition.content | html_escape }}
        </li>
      {% endfor %}
    </ol>
  {% endmacro %}

  {% for entry in entries %}
    {% if entry.kind == 'lemma' or not entry.links %}
      <article id="{{ entry.id | html_escape }}">
        <h2>{{ entry.forms | join(', ') | html_escape }}</h2>

        {% if entry.ety %}
          <p>{{ entry.ety | html_escape }}</p>
        {% endif %}

        {{ definitions(entry) }}

        {% for expression in entry.expressions %}
          <h3>{{ expression.lemma | html_escape }}</h3>
          {% if expression.ety %}
            <p>{{ expression.ety | html_escape }}</p>
          {% endif %}
          {{ definitions(expression) }}
        {% endfor %}
      </article>
    {% endif %}
  {% endfor %}
</body>
</html>
